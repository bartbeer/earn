# Copy this file to .env and fill in values for your environment.
# Never commit the real .env file.

# Local Supabase (from `supabase start`) or a hosted Supabase project URL.
# On a physical device, "localhost" refers to the device itself, not your
# development machine — use your machine's LAN IP instead (e.g. http://192.168.1.20:54321).
# Simulators/emulators can typically use http://localhost:54321 or http://10.0.2.2:54321 (Android emulator).
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321

# Local Supabase anon key (printed by `supabase start`), or the hosted project's anon key.
# This key is safe for client use only because Row Level Security enforces access control.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
